  "patterns": [
    {
      "name": "spurious_shadda_on_function_words",
      "description": "Mishkal adds spurious shadda to common function words that should never have shadda: على (11.9%), لم (9.6%), قد (9.8%), كما (12.8%), حين (20%). For example, عَلَّى instead of عَلَى, لَمَّ instead of لَمْ, قَدٍّ instead of قَدْ.",
      "frequency": "Affects ~14% of poems (29/204). Most affected words: على (23 instances), لم (11), قد (9), كما (5), حين (4).",
      "severity": "high",
      "fixable": true,
      "fix_description": "For each function word (على, لم, قد, كما, حين, بعد), strip any shadda from the word when it appears as a standalone token. Use regex: replace عَلَّى with عَلَى, لَمَّ (followed by space) with لَمْ, etc."
    },
    {
      "name": "ya_possessive_to_nisba_corruption",
      "description": "Mishkal converts first-person possessive ya suffix (ي) to a nisba-like doubled ya (يّ) with shadda on the ya, often adding tanween. Examples: قَلْبِيٌّ instead of قَلْبِي, مِنِّيُّ instead of مِنِّي, نَفْسِيٌّ instead of نَفْسِي, لَعَمْرِيٍّ instead of لَعَمْرِي.",
      "frequency": "Affects 55.4% of poems (113/204). ~493 individual word occurrences across all poems. Most affected: قلبي (16), علي (18), مني (12), أني (8), يدي (6), نفسي (5).",
      "severity": "high",
      "fixable": true,
      "fix_description": "For words ending in ي preceded by shadda (يّ), where the base word is a common noun/pronoun + possessive ya pattern, remove the shadda and any trailing tanween. Match pattern: [Arabic]يّ[tanween]? at word boundary -> [Arabic]ي. Must exclude legitimate nisba adjectives."
    },
    {
      "name": "impossible_hamza_kasra_sukun",
      "description": "Mishkal produces an impossible combination of kasra followed by sukun on hamza-alef (إِْ or أَْ). This is phonologically impossible and creates garbled text. Affects words like إذا, إن, إلا, أن, أنا.",
      "frequency": "Affects 22.1% of poems (45/204). 113 total occurrences. Most common: إذا (28), إن (23), أن (12), إلا (9).",
      "severity": "high",
      "fixable": true,
      "fix_description": "Remove the sukun that follows kasra on hamza letters. Regex: replace إِْ with إِ and أَْ with أَ. The sukun after a short vowel on these letters is always an error."
    },
    {
      "name": "poem_truncation",
      "description": "Mishkal truncates long poems, cutting off content beyond approximately 1400-1450 bare characters. The diacritized output loses the ending verses of the poem entirely.",
      "frequency": "Affects 10.8% of poems (22/204). Lost content ranges from 161 to 1018 characters.",
      "severity": "high",
      "fixable": false,
      "fix_description": "Not fixable by postprocessing. Requires re-diacritizing truncated poems with smaller chunks fed to Mishkal, or increasing Mishkal's character limit. Could split long poems at hemistich boundaries and process in segments."
    },
    {
      "name": "spurious_shadda_general",
      "description": "Mishkal roughly doubles the number of shaddas compared to the original text. Total shaddas go from 2930 in raw to 5856 in diacritized (~50% are spurious). Affected common words include: الدهر, الناس, أن, إلا, لما, لقد, كنت, الزمان, الذي.",
      "frequency": "Affects ~35% of poems (71/204 have dramatically more shaddas). Approximately 2926 spurious shaddas total.",
      "severity": "high",
      "fixable": false,
      "fix_description": "Partially fixable for known patterns (function words). General case requires comparing with original text and removing shaddas that were not in the raw input, but this risks removing legitimate corrections. Best approached by maintaining a whitelist of words that legitimately gain shadda during diacritization."
    },
    {
      "name": "missing_hemistich_final_tashkeel",
      "description": "37.8% of hemistich endings lack a final diacritical mark on the last Arabic letter. This is critical for poetry as the qafiya (rhyme) and i3rab depend on correct final vowels.",
      "frequency": "1889 out of 5003 hemistichs (37.8%) have missing final marks.",
      "severity": "medium",
      "fixable": true,
      "fix_description": "Already partially handled by the existing fix_line_ending_tashkeel_parallel function. Can be improved by using rhyme scheme detection to infer the correct final vowel from other hemistichs in the same poem."
    },
    {
      "name": "alif_lam_article_corruption",
      "description": "The definite article ال gets corrupted to اُلْ (with damma on alef and sukun on lam) when preceded by wa (و) or other conjunctions. Example: واُلْصُفَا instead of وَالصَّفَا.",
      "frequency": "20 occurrences across 5 poems.",
      "severity": "medium",
      "fixable": true,
      "fix_description": "Replace اُلْ preceded by وَ or فَ with الْ (restoring proper alif-lam article form). Regex: (وَ|فَ)اُلْ -> \\1الْ"
    },
    {
      "name": "sun_letter_assimilation_missing",
      "description": "In some cases, sun letter assimilation (idgham shamsi) is not applied when the definite article ال is followed by a sun letter. The lam should assimilate and the sun letter should have shadda, but some instances have الْ + sun letter without shadda.",
      "frequency": "231 missing assimilations detected out of 1571 sun letter article occurrences (14.7%).",
      "severity": "medium",
      "fixable": true,
      "fix_description": "When الْ is followed by a sun letter (ت ث د ذ ر ز س ش ص ض ط ظ ن ل), remove sukun from lam and add shadda to the sun letter. Pattern: الْ[sun_letter] -> ال[sun_letter]ّ"
    },
    {
      "name": "baad_verb_preposition_confusion",
      "description": "Mishkal diacritizes the preposition بَعْدَ (after) as the verb بَعُدَ (became distant) in some contexts where it is clearly a preposition.",
      "frequency": "7 occurrences across the sample.",
      "severity": "low",
      "fixable": false,
      "fix_description": "Context-dependent disambiguation. Would require sentence-level analysis to determine if بعد is used as a preposition (followed by noun/pronoun) or as a verb."
    },
    {
      "name": "letter_corruption_non_truncation",
      "description": "Some poems have character-level differences between raw and diacritized text that are not due to truncation. The bare (undiacritized) text differs, suggesting Mishkal altered, added, or removed characters.",
      "frequency": "35 poems (17.2%) have some form of bare text mismatch.",
      "severity": "medium",
      "fixable": false,
      "fix_description": "Would require character-level alignment between raw and diacritized text to detect and revert letter changes. Complex to automate reliably."
    },
    {
      "name": "shadda_tanween_word_ending",
      "description": "Some words incorrectly end with both shadda and tanween (e.g., قَلْبِيٌّ, لَعَمْرِيٍّ). This is usually a byproduct of the ya-nisba corruption pattern but also affects other words like لَقَدٍّ, تَعَدٍّ.",
      "frequency": "Appears in ~20% of poems. Most affected words: قلبي, لقد, من, لعمري, يدي, نفسي.",
      "severity": "medium",
      "fixable": true,
      "fix_description": "For words that should not end with shadda+tanween, strip the trailing shadda+tanween combination. This overlaps with the ya-nisba fix but also covers non-ya words like لقد, تعد, etc."
    }
  ],
