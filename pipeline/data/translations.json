  "freq_detail_spurious_shadda_function_words": {
    "en": "Affects ~14% of poems (29/204). Most affected words: على (23 instances), لم (11), قد (9), كما (5), حين (4).",
    "ar": "تؤثر في نحو 14% من القصائد (29/204). أكثر الكلمات تأثرًا: على (23 حالة)، لم (11)، قد (9)، كما (5)، حين (4)."
  },
  "freq_detail_ya_possessive_to_nisba": {
    "en": "Affects 55.4% of poems (113/204). ~493 individual word occurrences across all poems. Most affected: قلبي (16), علي (18), مني (12), أني (8), يدي (6), نفسي (5).",
    "ar": "تؤثر في 55.4% من القصائد (113/204). نحو 493 ظهورًا فرديًّا عبر جميع القصائد. أكثر الكلمات تأثرًا: قلبي (16)، علي (18)، مني (12)، أني (8)، يدي (6)، نفسي (5)."
  },
  "freq_detail_impossible_hamza_kasra_sukun": {
    "en": "Affects 22.1% of poems (45/204). 113 total occurrences. Most common: إذا (28), إن (23), أن (12), إلا (9).",
    "ar": "تؤثر في 22.1% من القصائد (45/204). 113 ظهورًا إجماليًّا. الأكثر شيوعًا: إذا (28)، إن (23)، أن (12)، إلا (9)."
  },
  "freq_detail_poem_truncation": {
    "en": "Affects 10.8% of poems (22/204). Lost content ranges from 161 to 1018 characters.",
    "ar": "يؤثر في 10.8% من القصائد (22/204). يتراوح المحتوى المفقود بين 161 و1018 حرفًا."
  },
  "freq_detail_spurious_shadda_general": {
    "en": "Affects ~35% of poems (71/204 have dramatically more shaddas). Approximately 2926 spurious shaddas total.",
    "ar": "تؤثر في نحو 35% من القصائد (71/204 تحتوي على شدّات أكثر بكثير). نحو 2926 شدّة زائدة إجمالًا."
  },
  "freq_detail_missing_hemistich_final_tashkeel": {
    "en": "1889 out of 5003 hemistichs (37.8%) have missing final marks.",
